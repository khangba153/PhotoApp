<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:gravity="center_horizontal"
    android:background="@drawable/user_card_background" android:padding="12dp">
    <ImageView android:id="@+id/userProfileImageView" android:layout_width="112dp"
        android:layout_height="112dp" android:scaleType="centerCrop"
        android:contentDescription="@string/profile_image" />
    <TextView android:id="@+id/usernameTextView" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:gravity="center"
        android:paddingTop="10dp" android:textColor="#28213A" android:textSize="18sp"
        android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/biographyTextView" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:gravity="center"
        android:paddingTop="6dp" android:textColor="#625A73" android:textSize="13sp"
        android:lines="2" android:ellipsize="end" />
</LinearLayout>
